<mvc:View controllerName="logaligroup.invoices.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Shell>
        <App>
            <pages>
                <Page title="{i18n>appTitle}">
                <headerContent>
                        <Button id="helloDialogHeader"
                                icon="sap-icon://action"
                                press=".onOpenDialogHeader"
                                class="sapUiSmallMargin"/>
                 </headerContent>
                    <content>
                        <mvc:XMLView viewName="logaligroup.invoices.view.HelloPanel"/>
                        <mvc:XMLView viewName="logaligroup.invoices.view.InvoicesList"/>
                    </content>
                </Page>
            </pages>
        </App>
    </Shell>
</mvc:View>